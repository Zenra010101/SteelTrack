# --- Virtual environment ---------------------------------------------------
.venv/
venv/
env/

# --- Credentials -----------------------------------------------------------
# .env holds the database URL and the shared API secret. Never commit it.
.env
.env.local
.env.*.local
!.env.example

# --- Model artifacts -------------------------------------------------------
# Trained weights are reproducible from the data; they are not source.
# The leading slash anchors this to the service root. Without it, "models/"
# also matches src/models/ — which is where the LSTM network and the model
# registry live — and the whole model source silently drops out of the repo.
# "build/" and "dist/" are anchored for the same reason.
/models/
*.pt
*.pth
*.onnx

# --- Python bytecode / caches ----------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ------------------------------------------------------------------
*.log
logs/
