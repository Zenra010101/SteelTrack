# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/SteelTrackDb

# --- Model storage --------------------------------------------------------
MODEL_DIR=./models

# --- API ------------------------------------------------------------------
# Shared secret sent by the .NET API in the X-LSTM-API-KEY header.
LSTM_API_KEY=dev-api-key-change-me

# --- LSTM defaults --------------------------------------------------------
LSTM_LOOKBACK_MONTHS=24
LSTM_HORIZON_MONTHS=3
LSTM_BATCH_SIZE=32
LSTM_MAX_EPOCHS=50
LSTM_LEARNING_RATE=0.001
LSTM_MIN_HISTORY_MONTHS=2

# --- Monitoring -----------------------------------------------------------
LSTM_METRICS_PORT=9090
LOG_LEVEL=INFO

# --- Scheduling -----------------------------------------------------------
LSTM_RETRAIN_HOUR=2
LSTM_ENABLE_SCHEDULER=true
