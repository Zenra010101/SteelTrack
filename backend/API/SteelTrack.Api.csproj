<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\..\frontend\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\SteelTrack.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\SteelTrack.Infrastructure.csproj" />
    <ProjectReference Include="..\Domain\SteelTrack.Domain.csproj" />
  </ItemGroup>


  <!-- Include Frontend files in Visual Studio Solution Explorer -->
  <ItemGroup>
    <Content Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**;$(SpaRoot)dist\**">
      <Link>frontend\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Include Python LSTM forecasting service source files in publish output
       so they are deployed alongside the .NET API. The .NET API calls the
       Python service over HTTP (localhost:8000), but having the source available
       makes it easier to run locally, package with Docker, or deploy as a
       combined artifact.  -->
  <ItemGroup>
    <Content Include="python-lstm-service\src\**" Exclude="python-lstm-service\src\__pycache__\**;python-lstm-service\.venv\**">
      <Link>python-lstm\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Include LSTM startup scripts so published output can launch the service -->
  <ItemGroup>
    <Content Include="scripts\*.bat" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="scripts\*.sh" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Build & Bundle Frontend into wwwroot during publish -->
  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <Message Importance="high" Text="Building frontend Vite production bundle for deployment..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" ContinueOnError="true" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
