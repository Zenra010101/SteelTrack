# ==============================================================================
# SteelTrack Enterprise Environment Variables Template
# Copy this file to .env and supply environment-specific credentials.
# NEVER commit real production secrets to version control.
# ==============================================================================

# --- Database (PostgreSQL) ----------------------------------------------------
POSTGRES_DB=SteelTrackDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Connection string for .NET API (Host can be localhost or 'postgres' in Docker)
ConnectionStrings__DefaultConnection=Server=localhost;Port=5432;Database=SteelTrackDb;User Id=postgres;Password=your_secure_postgres_password_here;Ssl Mode=Prefer;Trust Server Certificate=true;
ConnectionStrings__PostgreSQLConnection=Server=localhost;Port=5432;Database=SteelTrackDb;User Id=postgres;Password=your_secure_postgres_password_here;Ssl Mode=Prefer;Trust Server Certificate=true;

# Database URL for Python LSTM AsyncPG Service
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@localhost:5432/SteelTrackDb

# --- JWT Authentication -------------------------------------------------------
Jwt__Secret=YOUR_VERY_LONG_64_CHAR_RANDOM_SECRET_KEY_FOR_JWT_PRODUCTION_SIGNING_123!
Jwt__Issuer=SteelTrack
Jwt__Audience=SteelTrack
Jwt__ExpirationHours=12

# --- LSTM Demand Forecasting Microservice ------------------------------------
Lstm__BaseUrl=http://localhost:8000
Lstm__ApiKey=your_secure_lstm_api_shared_secret
LSTM_API_KEY=your_secure_lstm_api_shared_secret
LSTM_LOOKBACK_MONTHS=24
LSTM_HORIZON_MONTHS=3
LSTM_MIN_HISTORY_MONTHS=2
LSTM_METRICS_PORT=9090
LOG_LEVEL=INFO

# --- Cloud Secrets Management Reference Hooks ---------------------------------
# To load secrets directly from Azure Key Vault or AWS Secrets Manager:
# AZURE_KEYVAULT_URI=https://steeltrack-vault.vault.azure.net/
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=your_azure_service_principal_secret

# AWS_REGION=ap-southeast-1
# AWS_SECRET_NAME=steeltrack/production/credentials

# --- Frontend Application -----------------------------------------------------
VITE_API_URL=http://localhost:5000
PORT=5173
HOST=0.0.0.0

