# SteelTrack Production Caddy Configuration
# Domain: steeltrackerp.com

steeltrackerp.com, www.steeltrackerp.com {
    # Proxy all backend API requests to the .NET API
    handle /api/* {
        reverse_proxy steeltrack-api:5000
    }

    # Proxy SignalR real-time websocket connections to the .NET API
    handle /hubs/* {
        reverse_proxy steeltrack-api:5000
    }

    # Health check endpoints
    handle /health {
        reverse_proxy steeltrack-api:5000
    }

    # Swagger documentation
    handle /swagger* {
        reverse_proxy steeltrack-api:5000
    }

    # Proxy all other requests to the Vite React frontend
    handle {
        reverse_proxy vite-preview:5173
    }
}

api.steeltrackerp.com {
    reverse_proxy steeltrack-api:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}
